{
  "name": "venom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "db:up": "docker compose up --detach --wait",
    "db:down": "docker compose down",
    "db:setup": "pnpm --filter @venom/db run setup",
    "db:status": "pnpm --filter @venom/db run status",
    "power:grant": "pnpm --filter @venom/power run grant",
    "gateway":"pnpm --filter @venom/gateway run dev",
    "brain": "uv run --package venom-orchestrator venom-brain",
    "desktop": "pnpm --filter @venom/desktop run dev",
    "desktop:second": "pnpm --filter @venom/desktop run dev:second",
    "generate": "pnpm --filter @venom/contracts generate",
    "typecheck": "pnpm -r typecheck && pyright",
    "test": "pnpm -r test && uv run pytest",
    "check": "pnpm generate && pnpm typecheck && pnpm test",
    "model:check": "uv run scripts/model-check.py"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "pyright": "1.1.414",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
